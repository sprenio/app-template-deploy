# Environment configuration for production deployment
# Copy this file to .env and fill in strong, unique production values.

# --------------------------------------------------
# Deployment / Registry (GHCR)
# --------------------------------------------------
GHCR_OWNER=sprenio

# App identifier used in GHCR image names (ghcr.io/<owner>/<slug>-*).
# Must match the application repo's GitHub Actions var APP_SLUG (or its lowercase repo name if unset).
APP_SLUG=myapp

# Docker Compose project namespace (prefixes containers and internal networks).
# Keep ${APP_SLUG} unless running multiple instances (e.g. staging) on the same host.
COMPOSE_PROJECT_NAME=${APP_SLUG}

# --------------------------------------------------
# Application
# --------------------------------------------------
APP_NAME="My Application"
FRONTEND_BASE_URL=https://myapp.yourdomain.com

JWT_SECRET="generate-a-strong-random-secret-key-here"
ACCESS_TOKEN_TTL_MINUTES=15

REGISTER_ENABLED=false
RESET_PASSWORD_ENABLED=true
CONFIRMATION_ENDPOINT="/confirm/{token}"

# --------------------------------------------------
# Database (MariaDB)
# --------------------------------------------------
DB_ROOT_PASSWORD=generate-strong-mariadb-root-password
DB_DATABASE=${APP_SLUG}
DB_USER=${APP_SLUG}
DB_PASSWORD=generate-strong-mariadb-user-password

# --------------------------------------------------
# Message Broker (RabbitMQ)
# --------------------------------------------------
RABBITMQ_USER=${APP_SLUG}
RABBITMQ_PASSWORD=generate-strong-rabbitmq-password

# --------------------------------------------------
# Cache / In-memory Store (Redis)
# --------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# --------------------------------------------------
# Mail (SMTP)
# --------------------------------------------------
SMTP_HOST=smtp.yourprovider.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-user
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=no-reply@yourdomain.com

# --------------------------------------------------
# Persistent Storage Directories (Absolute paths on VPS)
# --------------------------------------------------
# E.g. under /srv/${COMPOSE_PROJECT_NAME} or /var/lib/${COMPOSE_PROJECT_NAME}
STORAGE_DIR=/srv/${COMPOSE_PROJECT_NAME}/storage
DB_DATA_DIR=${STORAGE_DIR}/db/data
DB_LOGS_DIR=${STORAGE_DIR}/db/logs
RABBITMQ_DATA_DIR=${STORAGE_DIR}/rabbitmq/data
RABBITMQ_LOGS_DIR=${STORAGE_DIR}/rabbitmq/logs
NGINX_LOGS_DIR=${STORAGE_DIR}/nginx/logs
REDIS_DATA_DIR=${STORAGE_DIR}/redis/data
ASSETS_DIR=${STORAGE_DIR}/assets

